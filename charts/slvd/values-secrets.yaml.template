# COPY TO values-secrets.yaml (gitignored) and fill in real values before deploy.
# The loop generates values-secrets.yaml locally at deploy time.
secrets:
  # litellm master key (from secret litellm-helm-masterkey in ns project-user-aieadmin)
  litellmApiKey: "REPLACE_ME"
  # >=32 chars, random
  jwtSecret: "REPLACE_ME_32+"
  # >=32 chars, random (also used as MCP<->engine internal token)
  hmacSecret: "REPLACE_ME_32+"
  # openclaw gateway token (from the nemoclaw release)
  openclawToken: "REPLACE_ME"
